# Ejemplo FICTICIO. Copiar parámetros exactos del panel Connect de Supabase.
# No usar la clave service_role. La contraseña debe ir percent-encoded en la URI.
# Conexión directa o Session pooler; no Transaction pooler en este MVP.
DATABASE_URL=postgresql://postgres.project-ref:CHANGE_ME@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full
# development, test o production. Producción exige verify-full.
APP_ENV=development
PIPELINE_DATABASE_URL=postgresql://pipeline_runner.project-ref:CHANGE_ME@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full
LOG_LEVEL=INFO
# Certificado descargado del proyecto; ruta relativa a .env o absoluta.
# Necesario para verify-ca/verify-full. Guardar en ruta ignorada por Git.
DATABASE_SSL_ROOT_CERT=data/private/supabase-ca.crt
